#!/bin/bash
# Не даёт запушить в МЁРТВУЮ ветку — ту, чей PR уже смержен или закрыт.
#
# ⚠ ЭТОТ РЕПОЗИТОРИЙ — где потери и случились. Замер 19.11.2026: за смену в
# `cafe13-miniapp` ушли в мёртвые ветки ЧЕТЫРЕ правки — `4870bf0` описи
# (снятие ложной причины), 4 коммита дизайнера на `designer/schet-nastoyashchiy`
# (договор остатка `ostatok.md`, из-за чего встал клиент шага 20), и дважды
# раньше. Прибора проекта (`check-branch-alive.sh`) здесь НЕТ — работает ветка
# `gh` ниже, проверено на мёртвом `#309` (rc=1) и живом `#319` (rc=0).
#
# Повод, замер 19.11.2026: за одну смену три коммита уехали в мёртвые ветки и
# пропали молча. Push возвращал ноль, ветка принимала коммит, в ствол он не
# попадал. Потери: `c2eb374` (просьба владельца о разбивке отчёта по стадиям,
# нашлась через 40 минут), `4870bf0` (снятие ложной причины в скрипте описи,
# в `dev` до сих пор неверный комментарий), и тот же класс в `#274` раньше.
# Правило (AGENTS.md §7) и прибор существовали — не хватало МАШИНЫ: правило
# надо вспомнить, хук срабатывает сам.
#
# Ставится один раз на клон (worktree делят конфиг):
#     git config core.hooksPath tools/hooks
# Снимается:  git config --unset core.hooksPath
# Обойти разово (когда push в мёртвую ветку нужен сознательно):
#     git push --no-verify
#
# ⚠ Отказ хука — НЕ «ветка плохая», а «этот push ничего не доставит»: правка
# едет новой ветвью от свежего ствола. Код возврата 1 валит push.
# ⚠ Хук НЕ судит, доедет ли коммит до ствола: он судит только жизнь ветки.
# ⚠ Имена переменных только ASCII (блок rules-obolochka).
set -u

PRIBOR='scripts/boilerplate/check-branch-alive.sh'
TOP=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

skip() { echo "pre-push: $1 — ветку не проверяю, push пропускаю" >&2; exit 0; }

command -v gh >/dev/null || skip 'нет gh'
command -v git >/dev/null || skip 'нет git'

# Ветки читаются ИЗ ВВОДА хука (<local ref> <local sha> <remote ref> <remote sha>),
# а не из HEAD: push может нести не ту ветку, на которой стоишь.
dead=0
while read -r lref lsha rref rsha; do
    [ -n "${rref:-}" ] || continue
    case "$lsha" in 0000000000000000000000000000000000000000) continue;; esac  # удаление ветки
    br=${rref#refs/heads/}
    [ -n "$br" ] || continue

    if [ -x "$TOP/$PRIBOR" ]; then
        # Прибор проекта знает семантику кодов: 1 — ветка мертва, 3 — мертва БАЗА
        # открытого PR (push безопасен), 2 — проверка НЕ выполнена (это не «жива»).
        # TRUNK передаётся как есть: прибор сам берёт ствол из AGENT_LOOP.md,
        # а пустой TARGET_BRANCH сбил бы это. В cafe13-api AGENT_LOOP.md нет —
        # там прибора нет тоже, и работает ветка gh ниже.
        out=$(cd "$TOP" && bash "$PRIBOR" "$br" 2>&1)
        rc=$?
    else
        # Без прибора — тот же вопрос прямо у GitHub: ПОСЛЕДНИЙ PR этой ветки.
        # ⚠ Код возврата gh снимается ОТДЕЛЬНОЙ строкой и читается ПЕРВЫМ:
        # без этого сеть, токен или лимит API давали rc=0 и push в мёртвую
        # ветку проходил МОЛЧА — правдоподобный успех вместо явного отказа.
        out=$(gh pr list --head "$br" --state all --limit 1 \
                 --json number,state -q '.[0] | "\(.number) \(.state)"' 2>&1)
        gh_rc=$?
        if [ "$gh_rc" -ne 0 ]; then
            rc=2
        else
            case "$out" in
                *MERGED*|*CLOSED*) rc=1;;
                *) rc=0;;        # пустой вывод = у ветки нет PR, это «жива»
            esac
        fi
    fi

    case "$rc" in
        1) echo "pre-push: ОТКАЗ — ветка '$br' МЕРТВА (её PR смержен или закрыт)." >&2
           echo "  $out" >&2
           echo "  Push прошёл бы зелёным и никуда не поехал. Заведи новую ветку" >&2
           echo "  от свежего ствола и перенеси правку туда (git cherry-pick)." >&2
           echo "  Сознательно нужно именно это? git push --no-verify" >&2
           dead=1;;
        2) echo "pre-push: проверка НЕ ВЫПОЛНЕНА по '$br' — это не «жива»:" >&2
           echo "  $out" >&2
           echo "  Проверь руками, затем git push --no-verify" >&2
           dead=1;;
        3) echo "pre-push: у '$br' мертва БАЗА открытого PR — push безопасен," >&2
           echo "  но базу надо перецелить." >&2;;
    esac
done

exit "$dead"
